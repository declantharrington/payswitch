// ─── CANVAS SETUP ───────────────────────────────────────────
const canvas = document.getElementById('terminal-canvas');
const ctx = canvas.getContext('2d');
const TOTAL_FRAMES = 160;
const FRAME_WIDTH = 1280;
const FRAME_HEIGHT = 720;

canvas.width = FRAME_WIDTH;
canvas.height = FRAME_HEIGHT;

// ─── PRELOAD ────────────────────────────────────────────────
const images = new Array(TOTAL_FRAMES);
let loadedCount = 0;
let allLoaded = false;
const loaderBar = document.getElementById('loaderBar');
const loaderPct = document.getElementById('loaderPct');
const loader = document.getElementById('loader');

function onImageLoad() {
  loadedCount++;
  const pct = Math.round((loadedCount / TOTAL_FRAMES) * 100);
  loaderBar.style.width = pct + '%';
  loaderPct.textContent = 'Loading experience — ' + pct + '%';

  if (loadedCount === TOTAL_FRAMES) {
    allLoaded = true;
    // Draw first frame immediately
    ctx.drawImage(images[0], 0, 0);
    // Small delay for polish then hide loader
    setTimeout(() => {
      loader.classList.add('hidden');
    }, 400);
  }
}

// Stagger loads slightly to avoid browser blocking
FRAME_DATA.forEach((src, i) => {
  const img = new Image();
  img.onload = onImageLoad;
  img.onerror = onImageLoad; // count errors too
  img.src = src;
  images[i] = img;
});

// ─── SCROLL ANIMATION ───────────────────────────────────────
const scrollSection = document.getElementById('scroll-section');
const scrollFill = document.getElementById('scrollFill');
const frameBadge = document.getElementById('frameBadge');

let currentFrame = 0;
let targetFrame = 0;
let rafId = null;
let lastDrawnFrame = -1;

function getScrollProgress() {
  const rect = scrollSection.getBoundingClientRect();
  const sectionTop = scrollSection.offsetTop;
  const sectionHeight = scrollSection.offsetHeight - window.innerHeight;
  const scrollY = window.scrollY;
  const progress = Math.max(0, Math.min(1, (scrollY - sectionTop) / sectionHeight));
  return progress;
}

function drawFrame(frameIndex) {
  if (!allLoaded) return;
  const img = images[frameIndex];
  if (!img || !img.complete) return;
  if (frameIndex === lastDrawnFrame) return;

  // Cinematic: slight vignette composite
  ctx.clearRect(0, 0, FRAME_WIDTH, FRAME_HEIGHT);
  ctx.drawImage(img, 0, 0, FRAME_WIDTH, FRAME_HEIGHT);
  lastDrawnFrame = frameIndex;

  // Update badge
  const frameNum = String(frameIndex + 1).padStart(3, '0');
  frameBadge.textContent = 'FRAME ' + frameNum + ' / 160';
}

function lerp(a, b, t) {
  return a + (b - a) * t;
}

function animate() {
  rafId = requestAnimationFrame(animate);

  // Smooth lerp toward target
  const easedFrame = lerp(currentFrame, targetFrame, 0.18);
  currentFrame = easedFrame;

  const roundedFrame = Math.round(currentFrame);
  const clampedFrame = Math.max(0, Math.min(TOTAL_FRAMES - 1, roundedFrame));

  drawFrame(clampedFrame);
}

window.addEventListener('scroll', () => {
  const progress = getScrollProgress();
  targetFrame = progress * (TOTAL_FRAMES - 1);

  // Update progress bar
  scrollFill.style.height = (progress * 100) + '%';

  });

}, { passive: true });

// Start animation loop
animate();

// ─── PARALLAX SUBTLETY ──────────────────────────────────────
// Subtle depth shift on mouse move
document.addEventListener('mousemove', (e) => {
  const cx = window.innerWidth / 2;
  const cy = window.innerHeight / 2;
  const dx = (e.clientX - cx) / cx;
  const dy = (e.clientY - cy) / cy;

  const stickyEl = document.querySelector('.sticky-container');
  if (stickyEl) {
    // Very subtle parallax on container
    stickyEl.style.transform = 'translate(' + (dx * 6) + 'px, ' + (dy * 4) + 'px)';
  }
}, { passive: true });
